---
import Base from "../layouts/Base.astro";
import Detail from "../components/Detail.astro";
import { contact, site } from "../content";
---

<Base title="Contact · Muneef Mumthas" back={{ href: "/", label: site.home }} footer={false}>
  <main class="page contact">
    <h1 class="page__headline rise">{contact.title}</h1>
    <ul class="contact__list">
      {contact.details.map((d, i) => <Detail {...d} class="rise" style={`--d:${i}`} />)}
    </ul>
  </main>
</Base>

<style>
  .contact__list { display: grid; gap: 28px 24px; margin-top: clamp(48px, 7vw, 96px); }
  .contact__list :global(.detail a) { font-size: clamp(22px, 2.1vw, 30px); }
  @media (min-width: 900px) {
    .contact__list { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 1000px; }
  }
</style>
