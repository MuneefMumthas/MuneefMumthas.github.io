---
// A guided walkthrough of real screens: chapter tabs, one screen at a time in a browser window or a phone,
// numbered marks outlining the element they describe, and the same numbered list beside it.
// Marks are measured from the real elements by the capture scripts in qa/tools (x, y, w, h as % of the screen).
import { Image } from "astro:assets";
import { tourControls } from "../content";

export type Mark = { label: string; x: number; y: number; w?: number; h?: number; missing?: boolean };
export type Step = { id: string; chapter: string; title: string; url?: string; phone?: boolean; img: ImageMetadata; marks: Mark[] };
interface Props {
  name: string;
  title: string;
  note?: string;
  chapters: { id: string; name: string }[];
  steps: Step[];
  accent?: string;
}
const { name, title, note, chapters, steps: raw, accent = "#8f6bff" } = Astro.props;
const steps = raw.map((s, i) => {
  const inChapter = raw.filter((t) => t.chapter === s.chapter);
  return {
    ...s,
    i,
    pos: inChapter.indexOf(s) + 1,
    of: inChapter.length,
    chapterName: chapters.find((c) => c.id === s.chapter)!.name,
    marks: s.marks.filter((m) => !m.missing),
  };
});
const firstOf = (id: string) => steps.find((s) => s.chapter === id)!.i;
const headId = `tour-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const showTabs = chapters.length > 1;
---

<section class="fx-tour" data-tour aria-labelledby={headId} tabindex="-1" style={`--tour:${accent}`}>
  <div class="fx-tour__head">
    <h3 class="t-title" id={headId}>{title}</h3>
    {note && <p>{note}</p>}
  </div>
  {
    showTabs && (
      <div class="fx-tabs" role="tablist" aria-label={title}>
        {chapters.map((c) => (
          <button type="button" role="tab" class="fx-tab" data-tab={c.id} data-first={firstOf(c.id)} aria-selected="false">
            {c.name}
            <span>{steps.filter((s) => s.chapter === c.id).length}</span>
          </button>
        ))}
        <span class="fx-tabs__glow" aria-hidden="true" />
      </div>
    )
  }

  <div class="fx-stage">
    <div class:list={["fx-screens", { "has-phone": steps.some((s) => s.phone), "all-phone": steps.every((s) => s.phone) }]}>
      {
        steps.map((s) => (
          <figure class:list={["fx-shot", { "fx-shot--phone": s.phone, "is-active": s.i === 0 }]} data-step={s.i} data-chapter={s.chapter}>
            <div class={s.phone ? "fx-phone" : "fx-window"}>
              {!s.phone && (
                <div class="fx-bar" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                  {s.url && <span>{s.url}</span>}
                </div>
              )}
              <div class="fx-img">
                <Image
                  src={s.img}
                  alt={`${name}, ${s.chapterName}: ${s.title}`}
                  widths={s.phone ? [390, 780] : [800, 1400, 2000]}
                  sizes={s.phone ? "300px" : "(min-width: 1100px) 64vw, 100vw"}
                  loading={s.i < 2 ? "eager" : "lazy"}
                />
                {s.marks.map((m, k) => (
                  <button
                    type="button"
                    class:list={["fx-pin", { "fx-pin--left": m.x > 60, "fx-pin--up": m.y + (m.h ?? 0) > 72 }]}
                    style={`--x:${m.x}%; --y:${m.y}%; --w:${m.w ?? 0}%; --h:${m.h ?? 0}%; --k:${k}`}
                    data-pin={k}
                    tabindex="-1"
                  >
                    <i class="fx-pin__box" aria-hidden="true" />
                    <span>{k + 1}</span>
                    <em>{m.label}</em>
                  </button>
                ))}
              </div>
            </div>
          </figure>
        ))
      }
    </div>

    <div class="fx-notes">
      <div class="fx-notes__stack" aria-live="polite">
        {
          steps.map((s) => (
            <div class:list={["fx-note", { "is-active": s.i === 0 }]} data-note={s.i}>
              <p class="t-label">
                {showTabs ? `${s.chapterName} · ` : ""}
                {s.pos} of {s.of}
              </p>
              <h4>{s.title}</h4>
              <ol>
                {s.marks.map((m, k) => (
                  <li data-pin={k} style={`--k:${k}`}>
                    <span>{k + 1}</span>
                    {m.label}
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
      <div class="fx-ctrl">
        <button type="button" class="fx-btn" data-prev aria-label={tourControls.prev}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
        </button>
        <button type="button" class="fx-btn fx-btn--play" data-play aria-label={tourControls.pause} data-play-label={tourControls.play} data-pause-label={tourControls.pause} aria-pressed="true">
          <svg class="fx-i-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="3" height="10" rx="1" /><rect x="9" y="3" width="3" height="10" rx="1" /></svg>
          <svg class="fx-i-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.5v9l8-4.5z" /></svg>
        </button>
        <button type="button" class="fx-btn" data-next aria-label={tourControls.next}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
        </button>
        <span class="fx-count t-mono" data-count>1 / {steps.length}</span>
        <span class="fx-progress" aria-hidden="true"><span data-progress /></span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .fx-tour { --tour: #8f6bff; display: grid; gap: 18px; outline: none; }
  .fx-tour__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; }
  .fx-tour__head p { color: var(--muted); font-size: 15px; }
  .fx-tabs { position: relative; display: inline-flex; gap: 4px; padding: 5px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); justify-self: start; max-width: 100%; overflow-x: auto; scrollbar-width: none; }
  .fx-tab { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font: inherit; font-size: 15px; font-weight: 500; white-space: nowrap; cursor: pointer; transition: color 300ms var(--ease-state); }
  .fx-tab:hover { color: var(--fg); }
  .fx-tab span { font-family: var(--mono); font-size: 11px; opacity: 0.7; }
  .fx-tab[aria-selected="true"] { color: var(--bg); }
  .fx-tabs__glow { position: absolute; z-index: 0; top: 5px; bottom: 5px; left: 0; width: 0; border-radius: 999px; background: var(--fg); transition: transform 520ms var(--ease-arrive), width 520ms var(--ease-arrive); }

  .fx-stage { display: grid; gap: 16px; }
  /* Desktop screens set the stage's height; phone screens sit inside it, scaled to fit. */
  .fx-screens { --pad: clamp(10px, 2cqw, 26px); position: relative; display: grid; padding: var(--pad); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); overflow: hidden; }
  .fx-screens.all-phone { min-height: min(78vh, 760px); }
  .fx-shot { grid-area: 1 / 1; margin: 0; display: grid; place-items: center; opacity: 0; visibility: hidden; transform: translateY(14px) scale(0.985); transition: opacity 600ms var(--ease-arrive), transform 700ms var(--ease-arrive), visibility 0s 600ms; }
  .fx-shot--phone { position: absolute; inset: var(--pad); display: block; }
  .fx-shot.is-active { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .fx-window { width: 100%; border-radius: 14px; overflow: hidden; background: #0c0c0d; box-shadow: 0 0 0 1px rgba(127, 127, 127, 0.18), 0 40px 80px -40px rgba(0, 0, 0, 0.55); }
  .fx-bar { display: flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px; background: #18181a; }
  .fx-bar i { width: 10px; height: 10px; border-radius: 50%; background: #3a3a3e; }
  .fx-bar span { margin-left: 12px; padding: 4px 12px; border-radius: 8px; background: #0f0f10; color: #a1a1a7; font-family: var(--mono); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx-phone { position: absolute; top: 0; bottom: 0; left: 50%; translate: -50% 0; aspect-ratio: 408 / 862; padding: 9px; border-radius: 46px; background: #050505; box-shadow: 0 0 0 2px #2a2a2d, 0 40px 80px -30px rgba(0, 0, 0, 0.6); }
  .fx-phone .fx-img { width: 100%; height: 100%; border-radius: 38px; overflow: hidden; }
  .fx-img { position: relative; --ox: 50%; --oy: 50%; transform-origin: var(--ox) var(--oy); transition: transform 900ms var(--ease-arrive); }
  .fx-img img { display: block; width: 100%; height: auto; }
  .fx-phone .fx-img img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .fx-img.is-zoom { transform: scale(1.06); }
  .fx-window .fx-img.is-zoom { transform: scale(1.1); }

  /* A mark: an outline around the real element, with its number on the corner and its label beside it. */
  .fx-pin { position: absolute; left: var(--x); top: var(--y); width: var(--w); height: var(--h); padding: 0; border: 0; background: none; cursor: pointer; }
  .fx-pin__box { position: absolute; inset: -8px; border-radius: 10px; border: 2px solid var(--tour); background: color-mix(in srgb, var(--tour) 10%, transparent); opacity: 0; transform: scale(1.04); transition: opacity 300ms var(--ease-state), transform 420ms var(--ease-arrive); pointer-events: none; }
  .fx-pin > span { position: absolute; z-index: 1; top: -8px; left: -8px; display: grid; place-items: center; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: var(--tour); color: #0b0b0c; font-family: var(--mono); font-size: 12px; font-weight: 700; box-shadow: 0 0 0 2px #0b0b0c, 0 6px 16px -4px rgba(0, 0, 0, 0.6); transform: scale(0); }
  .is-active .fx-pin > span { animation: fx-pop 520ms var(--ease-arrive) both; animation-delay: calc(420ms + var(--k) * 120ms); }
  @keyframes fx-pop {
    from { transform: scale(0); }
    60% { transform: scale(1.15); }
    to { transform: scale(1); }
  }
  .fx-pin em { position: absolute; z-index: 2; top: calc(100% + 12px); left: -6px; width: max-content; max-width: 240px; padding: 7px 11px; border-radius: 9px; background: #fff; color: #0b0b0c; font-style: normal; font-size: 13px; font-weight: 500; line-height: 1.3; text-align: left; box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.55); opacity: 0; transform: translateY(-4px); transition: opacity 260ms var(--ease-state), transform 360ms var(--ease-arrive); pointer-events: none; }
  .fx-pin--left em { left: auto; right: -6px; }
  .fx-pin--up em { top: auto; bottom: calc(100% + 12px); transform: translateY(4px); }
  .fx-pin.is-hot { z-index: 3; }
  .fx-pin.is-hot .fx-pin__box { opacity: 1; transform: none; }
  .fx-pin.is-hot em { opacity: 1; transform: none; }

  .fx-notes { display: grid; gap: 14px; align-content: space-between; padding: 22px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .fx-notes__stack { display: grid; }
  .fx-note { grid-area: 1 / 1; display: grid; gap: 10px; align-content: start; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity 420ms var(--ease-arrive), transform 520ms var(--ease-arrive), visibility 0s 420ms; }
  .fx-note.is-active { opacity: 1; visibility: visible; transform: none; transition-delay: 120ms; }
  .fx-note h4 { font-size: clamp(24px, 2.4cqw, 32px); font-weight: 500; letter-spacing: -0.03em; }
  .fx-note ol { display: grid; gap: 4px; margin-top: 4px; }
  .fx-note li { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; align-items: center; padding: 9px 10px; border-radius: 12px; font-size: 15px; line-height: 1.4; color: var(--fg); cursor: default; transition: background-color 260ms var(--ease-state); }
  .fx-note li span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--line-strong); font-family: var(--mono); font-size: 12px; transition: background-color 260ms, color 260ms, border-color 260ms; }
  .fx-note li.is-hot { background: var(--glass-hover); }
  .fx-note li.is-hot span { background: var(--tour); border-color: var(--tour); color: #0b0b0c; }
  .fx-note.is-active li { animation: app-in 600ms var(--ease-arrive) both; animation-delay: calc(200ms + var(--k) * 90ms); }

  .fx-ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .fx-btn { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: transparent; color: var(--fg); cursor: pointer; transition: background-color 260ms var(--ease-state); }
  .fx-btn:hover { background: var(--glass-hover); }
  .fx-btn svg { width: 16px; height: 16px; }
  .fx-btn--play .fx-i-play, .fx-btn--play[aria-pressed="false"] .fx-i-pause { display: none; }
  .fx-btn--play[aria-pressed="false"] .fx-i-play { display: block; }
  .fx-count { margin-left: 4px; font-size: 12px; color: var(--muted); }
  .fx-progress { flex: 1 1 100%; height: 3px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .fx-progress span { display: block; height: 100%; width: 100%; background: var(--fg); transform-origin: left; transform: scaleX(0); }
  .fx-progress span.is-running { animation: fx-run var(--dur, 8s) linear both; }
  .fx-progress span.is-held { animation-play-state: paused; }
  @keyframes fx-run {
    to { transform: scaleX(1); }
  }

  /* Narrow screens: the outline and number stay, the label moves to the list below the screen. */
  .fx-pin em { display: none; }
  @container os (min-width: 760px) {
    .fx-pin em { display: block; }
  }
  @container os (max-width: 759px) {
    .fx-window .fx-img.is-zoom { transform: scale(1.9); }
    .fx-img { transition-duration: 1100ms; }
    .fx-pin > span { width: 18px; height: 18px; margin: -9px 0 0 -9px; font-size: 10px; }
    .fx-pin__box { inset: -3px; border-width: 1.5px; border-radius: 6px; }
    .fx-phone { padding: 5px; border-radius: 26px; }
    .fx-phone .fx-img { border-radius: 22px; }
  }
  @container os (min-width: 1100px) {
    .fx-stage { grid-template-columns: minmax(0, 1fr) 320px; align-items: stretch; }
  }
</style>

<script>
  import "../scripts/tour";
</script>
