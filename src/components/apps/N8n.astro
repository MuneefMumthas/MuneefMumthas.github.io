---
import { engine, ui } from "../../content";
import graph from "../../assets/workflow.json";

// The exported graph is laid out for n8n's canvas. It is stretched a little so the labels are readable here.
const KX = 1.3;
const KY = 1.12;
const NW = 190;
const NH = 50;
const PAD = 24;
const W = Math.round(graph.width * KX + PAD * 2);
const H = Math.round(graph.height * KY + PAD * 2 + 20);

const lines = (text: string) => {
  if (text.length <= 22) return [text];
  const words = text.split(" ");
  let best = 1;
  for (let i = 1; i < words.length; i++) {
    const left = words.slice(0, i).join(" ").length;
    if (Math.abs(left - text.length / 2) < Math.abs(words.slice(0, best).join(" ").length - text.length / 2)) best = i;
  }
  return [words.slice(0, best).join(" "), words.slice(best).join(" ")];
};

const nodes = graph.nodes.map((node) => ({
  id: node.name,
  kind: node.kind,
  x: Math.round(node.x * KX + PAD),
  y: Math.round(node.y * KY + PAD),
  lines: lines(node.name),
}));
const byId = new Map(nodes.map((node) => [node.id, node]));

const edges = graph.edges.map((edge) => {
  const a = byId.get(edge.from)!;
  const b = byId.get(edge.to)!;
  let d: string;
  if (b.x > a.x + NW / 2) {
    // Forward: leave the right side, arrive at the left side.
    const x1 = a.x + NW;
    const y1 = a.y + NH / 2;
    const x2 = b.x;
    const y2 = b.y + NH / 2;
    const bend = Math.max(24, (x2 - x1) / 2);
    d = `M${x1} ${y1}C${x1 + bend} ${y1} ${x2 - bend} ${y2} ${x2} ${y2}`;
  } else {
    // Backward: drop below the row, run back, and come up into the target.
    const far = a.x - b.x > 1200;
    const lane = far ? H - 14 : Math.max(a.y, b.y) + NH + 16;
    const x1 = a.x + NW / 2;
    const x2 = b.x + NW / 2;
    d = `M${x1} ${a.y + NH}V${lane - 10}Q${x1} ${lane} ${x1 - 10} ${lane}H${x2 + 10}Q${x2} ${lane} ${x2} ${lane - 10}V${b.y + NH}`;
  }
  return { from: edge.from, to: edge.to, d };
});
---

<article class="app" id="n8n" data-app="n8n">
  <div class="wrap">
    <div class="intro intro--split">
      <p class="t-label">{engine.eyebrow}</p>
      <h2 class="t-headline">{engine.title}</h2>
      <div class="prose">{engine.body.map((p) => <p>{p}</p>)}</div>
    </div>
  </div>

  <div class="block eng" data-engine>
    <div class="wrap eng__head">
      <dl class="eng__counters">
        <div><dt class="t-label">{engine.labels.task}</dt><dd><b data-task>1</b> {engine.labels.of} {engine.totals.tasks}</dd></div>
        <div><dt class="t-label">{engine.labels.zone}</dt><dd><b data-zone>1</b> {engine.labels.of} {engine.totals.zones}</dd></div>
        <div><dt class="t-label">{engine.labels.category}</dt><dd><b data-category>1</b> {engine.labels.of} {engine.totals.categories}</dd></div>
        <div><dt class="t-label">{engine.labels.checkpoints}</dt><dd><b data-checkpoints>0</b></dd></div>
        <div><dt class="t-label">{engine.labels.failed}</dt><dd><b data-failed>0</b></dd></div>
      </dl>
      <p class="eng__now"><span class="tag" data-state role="status">{engine.labels.state.idle}</span><span class="t-mono" data-now aria-hidden="true"></span></p>
    </div>

    <div class="eng__view" data-view tabindex="0" role="group" aria-label={engine.caption}>
      <svg class="eng__svg" viewBox={`0 0 ${W} ${H}`} width={W} height={H} style={`--eng-h:${H}`} data-world>
        <g class="eng__edges">
          {edges.map((edge) => <path d={edge.d} data-from={edge.from} data-to={edge.to} />)}
        </g>
        <g class="eng__nodes">
          {
            nodes.map((node) => (
              <g class={`eng__node eng__node--${node.kind}`} data-node={node.id} data-kind={node.kind} data-x={node.x + NW / 2} data-y={node.y + NH / 2} transform={`translate(${node.x} ${node.y})`}>
                <rect width={NW} height={NH} rx={node.kind === "trigger" ? 25 : 10} />
                {node.lines.map((line, i) => (
                  <text x={NW / 2} y={NH / 2 + (node.lines.length === 1 ? 5 : i === 0 ? -3 : 13)} text-anchor="middle">{line}</text>
                ))}
              </g>
            ))
          }
        </g>
        <circle class="eng__token" r="8" cx={nodes[0].x + NW / 2} cy={nodes[0].y + NH / 2} data-token />
      </svg>
    </div>

    <div class="wrap">
      <div class="eng__controls">
        <button class="btn btn--small btn--solid" type="button" data-act="toggle" data-run={engine.controls.play} data-pause={engine.controls.pause}>{engine.controls.play}</button>
        <button class="btn btn--small" type="button" data-act="fail">{engine.controls.fail}</button>
        <button class="btn btn--small" type="button" data-act="stop" data-stop={engine.controls.stop} data-resume={engine.controls.resume}>{engine.controls.stop}</button>
        <button class="btn btn--small" type="button" data-act="finish">{engine.controls.finish}</button>
        <button class="btn btn--small" type="button" data-act="restart">{engine.controls.restart}</button>
      </div>
      <p class="caption"><span class="tag">{ui.simulated}</span><span>{engine.caption}</span></p>
      <p class="eng__second t-muted">{engine.second}</p>
    </div>
  </div>
</article>

<script type="application/json" id="engine-data" set:html={JSON.stringify({ states: engine.labels.state, totals: engine.totals, kinds: engine.kinds })} />
<script>
  import "../../scripts/engine";
</script>

<style is:global>
  .eng__head { display: grid; gap: 20px; margin-bottom: 20px; }
  .eng__counters { display: flex; flex-wrap: wrap; gap: 16px 40px; }
  .eng__counters dd { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 15px; color: var(--muted); margin-top: 4px; }
  .eng__counters b { font-family: var(--sans); font-weight: 600; font-stretch: 88%; font-size: 30px; line-height: 1; letter-spacing: -0.02em; color: var(--fg); display: inline-block; min-width: 1.4ch; }
  .eng__now { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; min-height: 28px; font-size: 14px; }
  .eng__now .tag.is-live { background: var(--accent); color: var(--ink); border-color: var(--accent); }

  /* The graph is wider than any screen. The camera follows the task; the visitor can also scroll it. */
  .eng__view { overflow-x: auto; overflow-y: hidden; border-block: 1px solid var(--line); background: var(--stage); scrollbar-width: thin; scrollbar-color: var(--grey-dark) transparent; }
  .eng__svg { display: block; max-width: none; width: auto; height: calc(var(--eng-scale, 0.72) * 1px * var(--eng-h)); }
  .eng__edges path { fill: none; stroke: rgba(245, 245, 242, 0.28); stroke-width: 1.5; transition: stroke var(--t-state) var(--ease-state); }
  .eng__edges path.is-hot { stroke: var(--accent); stroke-width: 2.5; }
  .eng__node rect { fill: #1b1b1e; stroke: rgba(245, 245, 242, 0.5); stroke-width: 1.4; transition: fill var(--t-state) var(--ease-state), stroke var(--t-state) var(--ease-state); }
  .eng__node--branch rect { stroke-dasharray: 5 4; }
  .eng__node text { fill: #f5f5f2; font-family: var(--sans); font-size: 14px; font-weight: 500; transition: fill var(--t-state) var(--ease-state); }
  .eng__node.is-done rect { stroke: #f5f5f2; fill: #2a2a2e; }
  .eng__node.is-current rect { fill: var(--accent); stroke: var(--accent); }
  .eng__node.is-current text { fill: var(--ink); font-weight: 600; }
  .eng__token { fill: var(--accent); stroke: var(--ink); stroke-width: 2; }
  .eng__controls { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .eng__second { margin-top: 32px; max-width: 62ch; }
  @container os (min-width: 900px) {
    .eng__head { grid-template-columns: 1fr auto; align-items: end; }
    .eng__svg { --eng-scale: 0.9; }
  }
</style>
