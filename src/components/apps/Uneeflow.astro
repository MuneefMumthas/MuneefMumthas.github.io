---
import { Image } from "astro:assets";
import { uneeflow, ui } from "../../content";

const files = import.meta.glob<{ default: ImageMetadata }>("../../assets/uneeflow/*.png", { eager: true });
const image = (name: string) => files[`../../assets/uneeflow/${name}.png`].default;
const total = uneeflow.steps.length;
---

<article class="app" id="uneeflow" data-app="uneeflow">
  <div class="intro intro--split">
    <p class="t-label">{uneeflow.eyebrow}</p>
    <h2 class="t-headline">{uneeflow.title}</h2>
    <div class="prose">
      {uneeflow.body.map((p) => <p>{p}</p>)}
      <ul class="links">
        {uneeflow.links.map((l) => <li><a class="link" href={l.href} rel="noopener">{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <!-- The app's own screens, in order. Its Next and Back buttons are live: pressing them moves through the workflow. -->
  <div class="block uf" data-uneeflow>
    <ol class="uf__steps">
      {
        uneeflow.steps.map((step, i) => (
          <li class={i === 0 ? "is-active" : ""}>
            <button type="button" data-step={i}>
              <span class="t-mono">{String(i + 1).padStart(2, "0")}</span>
              <span><b>{step.name}</b><span class="uf__text">{step.text}</span></span>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="uf__stage">
      <ul class="uf__shots">
        {
          uneeflow.steps.map((step, i) => (
            <li class={i === 0 ? "is-active" : ""} data-kind={step.kind}>
              <figure>
                <div class="uf__window">
                  <Image src={image(step.file)} alt={step.alt} widths={[480, 800, 1160]} sizes="(min-width: 900px) 46vw, 90vw" loading={i === 0 ? "eager" : "lazy"} />
                  {step.kind === "window" && <button type="button" class="uf__hot uf__hot--back" data-go="-1" aria-label={uneeflow.inApp.back} />}
                  {step.kind === "window" && <button type="button" class="uf__hot uf__hot--next" data-go="1" aria-label={uneeflow.inApp.next} />}
                  {step.kind === "menu" && <button type="button" class="uf__hot uf__hot--start" data-go="1" aria-label={uneeflow.inApp.start} />}
                </div>
                <figcaption><span class="t-mono">{String(i + 1).padStart(2, "0")} / {total}</span><b>{step.name}</b><span>{step.text}</span></figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <p class="uf__nav">
        <button type="button" class="btn btn--small" data-go="-1">{uneeflow.previous}</button>
        <button type="button" class="btn btn--small btn--solid" data-go="1">{uneeflow.next}</button>
      </p>
      <p class="caption"><span class="tag">{ui.screenshot}</span><span>{uneeflow.note}</span></p>
    </div>
  </div>
</article>

<script>
  import "../../scripts/uneeflow";
</script>

<style is:global>
  .uf { display: grid; gap: 20px; }
  .uf__steps { display: none; }
  .uf__shots { display: grid; }
  .uf__shots li { display: none; }
  .uf__shots li.is-active { display: block; animation: app-in 320ms var(--ease-arrive) both; }
  .uf__shots figure { display: grid; gap: 12px; }
  .uf__window { position: relative; background: #1a1a1a; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .uf__window img { width: 100%; max-height: min(56cqh, 600px); object-fit: contain; }
  .uf__shots figcaption { display: grid; gap: 2px; font-size: 15px; }
  .uf__shots figcaption span:last-child { color: var(--muted); }
  .uf__shots figcaption .t-mono { font-size: 12px; color: var(--muted); }
  /* Hot areas sit exactly over the app's own buttons in the screenshots. */
  .uf__hot { position: absolute; border: 0; background: transparent; cursor: pointer; border-radius: 8px; transition: box-shadow var(--t-state) var(--ease-state), background-color var(--t-state) var(--ease-state); }
  .uf__hot:hover, .uf__hot:focus-visible { background: rgba(143, 107, 255, 0.25); box-shadow: 0 0 0 2px var(--accent); }
  .uf__hot--back { left: 3%; top: 6.4%; width: 18.2%; height: 4%; }
  .uf__hot--next { left: 78.8%; top: 6.4%; width: 18.2%; height: 4%; }
  .uf__hot--start { left: 37%; top: 36%; width: 25.6%; height: 6.4%; }
  /* The window images are letterboxed, so the hot areas are placed on a box with the image's own shape. */
  .uf__shots li:not([data-kind="report"]) .uf__window { width: min(100%, calc(min(56cqh, 600px) * 0.963)); margin-inline: auto; }
  .uf__shots li:not([data-kind="report"]) .uf__window img { max-height: none; }
  .uf__nav { display: flex; gap: 8px; }
  @container os (min-width: 900px) {
    .uf { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr); gap: 48px; align-items: start; }
    .uf__steps { display: grid; }
    .uf__steps button { display: grid; grid-template-columns: 3ch 1fr; gap: 12px; width: 100%; padding: 6px 0; text-align: left; background: none; border: 0; cursor: pointer; opacity: 0.45; transition: opacity var(--t-state) var(--ease-state); }
    .uf__steps button:hover { opacity: 0.8; }
    .uf__steps .t-mono { font-size: 12px; padding-top: 4px; }
    .uf__steps b { font-family: var(--mono); font-weight: 600; font-size: 15px; letter-spacing: -0.02em; }
    .uf__text { display: none; color: var(--muted); font-size: 14px; }
    .uf__steps li.is-active button { opacity: 1; }
    .uf__steps li.is-active b { background: var(--accent); color: var(--ink); padding: 0 5px; margin-left: -5px; border-radius: 3px; }
    .uf__steps li.is-active .uf__text { display: block; }
    .uf__shots figcaption { display: none; }
  }
</style>
