---
import "@fontsource-variable/instrument-sans/wdth.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/Footer.astro";
import { meta } from "../content";
import sansLatin from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  back?: { href: string; label: string };
  footer?: boolean;
}
const { title = meta.title, description = meta.description, back, footer = true } = Astro.props;
const image = new URL("og.png", meta.url).href;
const canonical = new URL(Astro.url.pathname, meta.url).href;
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- The body font is fetched with the page, so large text does not reflow when it arrives. -->
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#0e0e0f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- The theme is set before first paint, so the page never flashes the wrong one. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = "dark";
        try { theme = localStorage.getItem("theme") || "dark"; } catch (e) {}
        root.setAttribute("data-theme", theme);
        root.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <div class="frame-page">
      <Topbar back={back} />
      <slot />
      {footer && <Footer />}
    </div>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
